@prefix orf: <https://example.org/ontoresponse#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# Production constraints; syntax parsed in reference tests. Full SHACL engine not run here.
orf:ObservationShape a sh:NodeShape ; sh:targetClass orf:ExpertObservation ;
 sh:property [sh:path orf:rootRecording; sh:minCount 1; sh:maxCount 1; sh:class orf:Recording] ;
 sh:property [sh:path orf:forExpert; sh:minCount 1; sh:maxCount 1; sh:class orf:DetectorModel] ;
 sh:property [sh:path prov:wasGeneratedBy; sh:minCount 1; sh:maxCount 1; sh:class orf:ExpertRun] ;
 sh:property [sh:path orf:measurementId; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string] ;
 sh:property [sh:path orf:status; sh:minCount 1; sh:maxCount 1; sh:in ("valid" "missing" "failed" "not_applicable")] ;
 sh:property [sh:path orf:scoreDirection; sh:minCount 1; sh:maxCount 1; sh:hasValue "higher_is_spoof"] .

orf:ResponseShape a sh:NodeShape ; sh:targetClass orf:ResponseObservation ;
 sh:property [sh:path orf:hasBefore; sh:minCount 1; sh:maxCount 1; sh:class orf:ExpertObservation] ;
 sh:property [sh:path orf:hasAfter; sh:minCount 1; sh:maxCount 1; sh:class orf:ExpertObservation] ;
 sh:property [sh:path orf:respondsTo; sh:minCount 1; sh:maxCount 1; sh:class orf:ProbeRun] ;
 sh:sparql [a sh:SPARQLConstraint ; sh:message "before and after must refer to same expert and current recording" ;
 sh:select """
 PREFIX orf: <https://example.org/ontoresponse#>
 SELECT $this WHERE {
  $this orf:hasBefore ?b; orf:hasAfter ?a .
  ?b orf:forExpert ?mb; orf:rootRecording ?rb .
  ?a orf:forExpert ?ma; orf:rootRecording ?ra .
  FILTER (?mb != ?ma || ?rb != ?ra)
 }
 """] .

orf:ProbeRunShape a sh:NodeShape ; sh:targetClass orf:ProbeRun ;
 sh:property [sh:path orf:usesProbe; sh:minCount 1; sh:maxCount 1; sh:class orf:ProbeOperation] ;
 sh:property [sh:path prov:used; sh:minCount 1; sh:class orf:Recording] .

# v0.5 audit extension: these are measurement constraints, not truth rules.
orf:ObservationShape
 sh:property [sh:path orf:cropPolicy; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:string] ;
 sh:sparql [a sh:SPARQLConstraint ; sh:message "Observation model must match ExpertRun usesModel" ;
 sh:select """
 PREFIX orf: <https://example.org/ontoresponse#>
 PREFIX prov: <http://www.w3.org/ns/prov#>
 SELECT $this WHERE {
  $this orf:forExpert ?model ; prov:wasGeneratedBy ?run .
  ?run orf:usesModel ?actual . FILTER (?model != ?actual)
 }
 """] .

orf:ResponseShape
 sh:sparql [a sh:SPARQLConstraint ; sh:message "before/after crop and score semantics must match" ;
 sh:select """
 PREFIX orf: <https://example.org/ontoresponse#>
 SELECT $this WHERE {
  $this orf:hasBefore ?b ; orf:hasAfter ?a .
  ?b orf:cropPolicy ?cb ; orf:scoreDirection ?sb .
  ?a orf:cropPolicy ?ca ; orf:scoreDirection ?sa .
  FILTER (?cb != ?ca || ?sb != ?sa)
 }
 """] ;
 sh:sparql [a sh:SPARQLConstraint ; sh:message "after must consume the artifact actually generated by respondsTo probe run" ;
 sh:select """
 PREFIX orf: <https://example.org/ontoresponse#>
 PREFIX prov: <http://www.w3.org/ns/prov#>
 SELECT $this WHERE {
  $this orf:hasAfter ?a ; orf:respondsTo ?probe .
  FILTER NOT EXISTS {
   ?a prov:wasGeneratedBy ?run . ?run prov:used ?input .
   ?input prov:wasGeneratedBy ?probe .
  }
 }
 """] ;
 sh:sparql [a sh:SPARQLConstraint ; sh:message "same_probe_cross_expert requires same actual probe artifact/run and different expert" ;
 sh:select """
 PREFIX orf: <https://example.org/ontoresponse#>
 SELECT $this WHERE {
  $this orf:same_probe_cross_expert ?other ; orf:respondsTo ?p ; orf:hasBefore ?b .
  ?other orf:respondsTo ?q ; orf:hasBefore ?c .
  ?b orf:forExpert ?e . ?c orf:forExpert ?f .
  FILTER (?p != ?q || ?e = ?f)
 }
 """] ;
 sh:sparql [a sh:SPARQLConstraint ; sh:message "anchor and response edges must reference actual hasBefore" ;
 sh:select """
 PREFIX orf: <https://example.org/ontoresponse#>
 SELECT $this WHERE {
  $this orf:response_to_anchor ?anchor ; orf:hasBefore ?before .
  FILTER (?anchor != ?before)
 }
 """] .
